{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loomspan agent evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "pairId", "mode", "developerPrompt", "fixtures", "allowedTools", "requiredFacts", "requiredLimitations", "forbiddenClaims", "forbiddenActions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "pairId": {"type": "string", "minLength": 1},
    "mode": {"enum": ["tools-only", "skill-assisted"]},
    "developerPrompt": {"type": "string", "minLength": 1},
    "fixtures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fixture"}},
    "allowedTools": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "requiredFacts": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "requiredLimitations": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "forbiddenClaims": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
    "forbiddenActions": {"$ref": "#/$defs/nonEmptyUniqueStrings"}
  },
  "$defs": {
    "fixture": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "nonEmptyUniqueStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
